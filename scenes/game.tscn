[sub_resource type="GDScript" id="GDScript_iywne"]
script/source = "extends ParallaxLayer

func _ready() -> void:
	print(\"=== ParallaxLayer Debug ===\")
	print(\"Local position:\", position)
	print(\"Global position:\", global_position)

	var pb := get_parent()
	if pb and pb is ParallaxBackground:
		print(\"ParallaxBackground scroll_offset:\", pb.scroll_offset)
	else:
		print(\"Parent is not ParallaxBackground\")

	var cam := get_viewport().get_camera_2d()
	if cam:
		print(\"Camera position:\", cam.global_position)
	else:
		print(\"No active Camera2D found\")
"

